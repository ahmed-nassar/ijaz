# The website: the River page (Next.js) and its read API (FastAPI) in one image.
# Fly.io builds it with fly.web.toml. The collector has its own image (Dockerfile).

# 1. Build the Next.js app into a self-contained server.
FROM node:24-trixie-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web ./
RUN npm run build

# 2. Runtime: Python 3.14 for the API, plus the Node 24 binary for the web server.
FROM python:3.14-slim-trixie
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=8080 \
    HOSTNAME=0.0.0.0 \
    API_URL=http://127.0.0.1:8000
COPY --from=web /usr/local/bin/node /usr/local/bin/node

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install .

COPY --from=web /web/.next/standalone ./web
COPY --from=web /web/.next/static ./web/.next/static
COPY --from=web /web/public ./web/public
COPY deploy/start-web.sh ./start-web.sh

RUN useradd --system --no-create-home site
USER site
EXPOSE 8080
CMD ["sh", "./start-web.sh"]
