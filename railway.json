{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": "sh -c 'collector init-db && collector load-sources sources/sources.yaml'",
    "startCommand": "collector -v run",
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
